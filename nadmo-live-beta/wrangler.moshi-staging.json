{
  "name": "nadmo-live-moshi-v2-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_HUB",
        "class_name": "RoomHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomHub"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BETA_TEST_HOSTS_ENABLED": "false",
    "VERIFY_CREATOR_REQUIRED": "true",
    "NADMO_MOSHI_STAGING": "true"
  }
}
