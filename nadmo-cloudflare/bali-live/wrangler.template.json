{
  "name": "nadmo-balilive",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "balilive.nadmo.id/*",
      "zone_name": "nadmo.id"
    }
  ],
  "assets": {
    "directory": "./source/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
