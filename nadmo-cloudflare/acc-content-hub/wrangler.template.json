{
  "name": "nadmo-contenthub",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "contenthub.nadmo.id/*",
      "zone_name": "nadmo.id"
    }
  ],
  "assets": {
    "directory": "./source/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "SOCIAL_DB",
      "database_name": "nadmo-social-queue",
      "database_id": "e684674e-8e5b-4401-a771-cdd94d888b6a"
    }
  ],
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "SOCIAL_MEDIA",
      "bucket_name": "nadmo-social-private-media"
    }
  ]
}
