{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roamink",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "roamink.nadmo.id/*",
      "zone_name": "nadmo.id"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_STORE",
        "class_name": "OrderStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderStore"]
    }
  ]
}
