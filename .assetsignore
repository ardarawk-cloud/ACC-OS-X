# ACC OS X — Cloudflare Static Asset Boundary
# Keep runtime PWA files public; exclude dependencies, backend source, archives and build docs.

node_modules/
node_modules/**
.wrangler/
.wrangler/**
.git/
.git/**


# Non-ACC-OS-X project/infrastructure directories must never be published as OS X static assets.
.github/
.github/**
android/
android/**
apps/
apps/**
deploy-status/
deploy-status/**
handoffs/
handoffs/**
nadmo-cloudflare-src/
nadmo-cloudflare-src/**
nadmo-cloudflare/
nadmo-cloudflare/**
scripts/
scripts/**

# Backend Worker source is bundled through wrangler main/imports, not served as public assets.
worker.js
worker-*.js

# Deployment/build metadata should not be public assets.
wrangler.jsonc
package.json
package-lock.json
bun.lock
bun.lockb

# Internal archives and documentation are not runtime PWA assets.
*.zip
*.md
*.txt

# Local/editor noise.
.DS_Store
